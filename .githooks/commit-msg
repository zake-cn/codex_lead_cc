#!/bin/bash
# Block commits that include Claude/Anthropic as co-author.
# Claude Code must not appear as a contributor on this project.

COMMIT_MSG_FILE="$1"

if grep -qiE 'Co-Authored-By:.*(Claude|Anthropic|claude|anthropic)' "$COMMIT_MSG_FILE"; then
  echo ""
  echo "❌ REJECTED: Commit message contains a Claude/Anthropic co-author line."
  echo "   Claude Code is a tool, not a contributor. Please remove the line:"
  echo ""
  grep -niE 'Co-Authored-By:.*(Claude|Anthropic)' "$COMMIT_MSG_FILE" | sed 's/^/   /'
  echo ""
  exit 1
fi

exit 0
